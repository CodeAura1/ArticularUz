
# Required: set the real Telegram bot token in Botxona environment settings.
BOT_TOKEN=

# Required for Baserow profile and event syncing. Set in Botxona environment settings.
BASEROW_TOKEN=

# Optional: numeric Telegram channel ID for forwarding channel posts. Leave empty to disable.
ANNOUNCEMENT_CHANNEL_ID=

# Persistent data directory provided by the hosting platform.
DATA_DIR=/data
